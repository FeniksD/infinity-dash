[Unit]
Description=Infinity build security and integrity check
After=network.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /usr/local/lib/infinity-guard/guard.py --baseline /root/infinity-security/baseline.json --state-dir /var/lib/infinity-guard
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
